# SEC's API requires a real contact email in its request header. Put yours here:
SEC_USER_AGENT=biotech-agent your-real-email@example.com

# Needed for the chat and the trial embeddings. The rest of the app works without it.
# OPENAI_API_KEY=sk-...

# Questions /ask will answer per UTC day, for everyone together. There are no
# accounts, so this is the limit that actually caps the OpenAI spend. Unset
# means 500; 0 removes the cap, which is only sensible where nobody else can
# reach it.
ASK_DAILY_BUDGET=

# Where the database is. Unset, the app uses a local SQLite file, which is what
# a fresh clone gets. docker compose sets this to the Postgres beside it.
# DATABASE_URL=
