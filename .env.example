# Where the Python service lives. Unset, the frontend talks to a local one.
BIOBASE_API_URL=http://127.0.0.1:8000

# Shared secret for /ask, the only endpoint that calls the model and so the
# only one that costs money. Set the same value on the API as BIOBASE_API_KEY.
# Leave both unset in development and the endpoint stays open, as it was.
BIOBASE_API_KEY=
