# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# virtual environments
venv/
.venv/
env/
.env

# secrets / local config
*.local
secrets.*

# OS / editor junk
.DS_Store
.idea/
.vscode/
*.swp

# local database (regenerate with: python ingest.py)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# local raw snapshots. these are data, not source, and they grow every run.
# in a real deployment they live in S3 (set RAW_BUCKET) rather than here.
backend/raw/




# logs
*.log
logs/

# Node / Next.js (Readbase frontend)
node_modules/
.next/
next-env.d.ts
.vercel
*.tsbuildinfo

# local database backups taken before migrations
*.db.bak-*

# the frontend's copy of the API key. It is read server-side only, but it is
# still a secret and does not belong in the repository.
.env.local

# database dumps taken for a restore elsewhere. Large, and never part of an
# image or a commit — a 1 GB backup in the build context already broke one
# build with "no space left on device".
dumps/
*.dump
